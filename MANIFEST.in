include README.md
include LICENSE
include CMakeLists.txt
include Makefile
include .pre-commit-config.yaml
include .clang-format
include .ruff.toml

# *.inc carries the generated Eisel-Lemire power table included by
# fast_parse.hpp — an sdist missing it cannot compile.
recursive-include include *.h *.hpp *.inc
# *.txt carries src/strata/core_sources.txt (setup.py refuses to build
# without it) — an sdist missing it cannot compile.
recursive-include src *.c *.cc *.cpp *.cxx *.h *.hpp *.inc *.txt
recursive-include python *.py
recursive-include scripts *.py *.sh
recursive-include tests *.py *.cpp *.h *.hpp *.json *.txt
# The fuzz seeds are extensionless byte fixtures; the corpus-replay suite
# fails the test-gated build when they are absent.
graft tests/fuzz/corpus
