+@pytest.mark.parametrize("mode", MODES)
+@pytest.mark.parametrize("length", [1, 63, 64, 65, 129])
+def test_scalar_runs_after_container_preserve_separators(mode, length):
+    """api.md: exact JSON output across scalar runs and fallback boundaries."""
+    value = [
+        {"head": 1},
+        *[i / 7 for i in range(length)],
+        "clean",
+        'a"b',
+        "é",
+        "x" * 5000,
+        {"middle": 2},
+        *[str(i) for i in range(length)],
+        None,
+        -0.0,
+        float("inf"),
+        "tail",
+    ]
+    expected = value.copy()
+    expected[-2] = None
+    assert _dump(value, mode) == json.dumps(expected, separators=(",", ":"), ensure_ascii=False)
+
+
+@pytest.mark.parametrize("mode", MODES)
+def test_scalar_runs_follow_list_replacement_after_callback(mode):
+    """api.md mutation: a callback can replace the tail before a resumed run."""
+    value = [{"head": 1}, 1.5, "old"]
+
+    class ReplaceTail(int):
+        def __str__(self):
+            value[2:] = [i / 7 for i in range(65)] + ["clean", 'a"b', "tail"]
+            return BIG_TEXT
+
+    value[1] = ReplaceTail(BIG)
+    expected = [{"head": 1}, BIG] + [i / 7 for i in range(65)] + ["clean", 'a"b', "tail"]
+    assert _dump(value, mode) == json.dumps(expected, separators=(",", ":"), ensure_ascii=False)
