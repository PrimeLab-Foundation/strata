+@pytest.mark.parametrize("length", [0, 1, 4093, 4094, 8190, 8191, 32766, 65536])
+def test_dump_newline_across_output_boundaries_and_memory_calls(tmp_path, length):
+    # api.md: file output adds exactly one newline; dumps never adds one.
+    path = tmp_path / "output.json"
+    value = {"text": "x" * length, "escaped": "\n\t\"", "unicode": "é"}
+    for payload in (value, value, {}, value, [], value):
+        expected = strata.dumps(payload, return_type="bytes")
+        strata.dump(payload, path)
+        assert path.read_bytes() == expected + b"\n"
+        assert strata.dumps(payload, return_type="bytes") == expected
+        assert strata.dumps(payload).encode() == expected
+
+
+def test_failed_serialization_does_not_truncate_file(tmp_path):
+    path = tmp_path / "existing.json"
+    original = b'{"preserve":true}\n'
+    path.write_bytes(original)
+    for value, error in ((object(), TypeError), ({"bad": "\ud800"}, UnicodeEncodeError)):
+        with pytest.raises(error):
+            strata.dump(value, path)
+        assert path.read_bytes() == original
+
+
+@pytest.mark.skipif(os.name == "nt", reason="POSIX resource limits")
+def test_partial_file_write_failure_closes_descriptor(tmp_path):
+    # A real short write followed by EFBIG exercises the native loop; mocking
+    # Python os.write would not affect C++ write(). Limit only a child process.
+    code = """
+import errno, os, resource, signal, sys
+sys.path.insert(0, sys.argv[3])
+import strata
+signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
+original_limit = resource.getrlimit(resource.RLIMIT_FSIZE)
+resource.setrlimit(resource.RLIMIT_FSIZE, (4096, original_limit[1]))
+target = sys.argv[1]
+sentinel = os.open(sys.argv[2], os.O_WRONLY | os.O_CREAT, 0o600)
+os.close(sentinel)
+try:
+    try:
+        strata.dump({'value': 'x' * 16384}, target)
+    except OSError as error:
+        assert error.errno == errno.EFBIG, error
+    else:
+        raise AssertionError('expected a failed partial write')
+    assert os.stat(target).st_size == 4096
+    check = os.open(sys.argv[2], os.O_WRONLY)
+    assert check == sentinel, (check, sentinel)
+    os.close(check)
+finally:
+    # Instrumented builds flush a profile at exit; never truncate that file.
+    resource.setrlimit(resource.RLIMIT_FSIZE, original_limit)
+"""
+    result = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            code,
+            str(tmp_path / "limited.json"),
+            str(tmp_path / "sentinel"),
+            os.path.dirname(os.path.dirname(strata.__file__)),
+        ],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert result.returncode == 0, result.stderr
+
+
