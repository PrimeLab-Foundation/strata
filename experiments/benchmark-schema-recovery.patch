diff --git a/tests/unit/test_dumps_schema_recovery.py b/tests/unit/test_dumps_schema_recovery.py
new file mode 100644
index 0000000..8be82ab
--- /dev/null
+++ b/tests/unit/test_dumps_schema_recovery.py
@@ -0,0 +1,56 @@
+"""A document's schema churn must not disable caching of later documents.
+
+Output follows api.md's serialization contract. Owned-key counts additionally
+pin recovery without timing assertions or a public cache-inspection API.
+"""
+
+import json
+import sys
+
+import pytest
+
+import strata
+
+
+@pytest.mark.parametrize("mode", ["str", "bytes"])
+@pytest.mark.parametrize("history", ["one-call", "separate-calls", "failed-call"])
+def test_stable_schema_recovers_after_unrelated_documents(mode, history):
+    churn = [{f"unrelated-recovery-key-{i}": i} for i in range(200)]
+    if history == "separate-calls":
+        for record in churn:
+            strata.dumps([record], return_type=mode)
+    elif history == "failed-call":
+        with pytest.raises(TypeError):
+            strata.dumps([*churn, object()], return_type=mode)
+    else:
+        strata.dumps(churn, return_type=mode)
+
+    key = "".join(["stable", "-recovery-owned-key"])
+    records = [{key: i} for i in range(10)]
+    before = sys.getrefcount(key)
+    for _ in range(3):
+        assert json.loads(strata.dumps(records, return_type=mode)) == records
+    assert sys.getrefcount(key) == before + 1
+
+    # Retirement still bounds work within one adversarial document and releases
+    # its previous exact-string keys, including the recovered stable schema.
+    strata.dumps(churn, return_type=mode)
+    assert sys.getrefcount(key) == before
+
+
+@pytest.mark.parametrize("mode", ["str", "bytes"])
+def test_reentrant_churn_does_not_retire_outer_schema(mode):
+    key = "".join(["outer", "-recovery-owned-key"])
+    records = [{key: i} for i in range(10)]
+    strata.dumps(records, return_type=mode)
+
+    class Nested(int):
+        def __str__(self):
+            strata.dumps([{f"nested-churn-{i}": i} for i in range(200)])
+            return "7"
+
+    doc = [*records, {key: Nested(2**70)}, *records]
+    expected = [*records, {key: 7}, *records]
+    before = sys.getrefcount(key)
+    assert json.loads(strata.dumps(doc, return_type=mode)) == expected
+    assert sys.getrefcount(key) == before
