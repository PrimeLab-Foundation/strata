+@pytest.mark.parametrize("mode", MODES)
+def test_cached_record_integer_reservations_across_output_growth(mode):
+    """api.md: exact output across integer widths and staged-buffer growth."""
+    numbers = [0, -1, 10**6, -(10**8), 2**30 - 1, -(2**30 - 1), 2**30, -(2**30), BIG]
+    keys = tuple(f"field_{i}" for i in range(24))
+    rows = [
+        {key: numbers[(i + row) % len(numbers)] for i, key in enumerate(keys)} for row in range(100)
+    ]
+
+    def check():
+        assert _dump(rows, mode) == _compact(rows)
+
+    _on_a_fresh_thread(check)
