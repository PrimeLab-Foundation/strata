+@pytest.mark.parametrize("mode", MODES)
+def test_cached_record_ascii_reservations_across_output_growth(mode):
+    """api.md: exact string escaping and output across reservation boundaries."""
+    values = ["", "x", "a" * 15, "b" * 16, "c" * 17, "d" * 4061, "e" * 4062]
+    values += ['quote"slash\\line\n', "\x00\x1f", "snowman \u2603", "z" * 8193]
+    keys = tuple(f"field_{i}" for i in range(24))
+    rows = [
+        {key: values[(i + row) % len(values)] for i, key in enumerate(keys)} for row in range(20)
+    ]
+
+    def check():
+        assert _dump(rows, mode) == json.dumps(rows, separators=(",", ":"), ensure_ascii=False)
+
+    _on_a_fresh_thread(check)
