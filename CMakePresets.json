{
  "version": 4,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Debug, no LTO)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STRATA_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "bench",
      "displayName": "Bench (Release + LTO)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake-bench",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STRATA_ENABLE_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    }
  ]
}
